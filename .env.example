# ---------- IA (opcional) ----------
# Qualquer API compatível com OpenAI funciona: OpenAI, OpenRouter, Groq, Gemini (endpoint OpenAI), Ollama local etc.
# Deixe AI_API_KEY vazio para rodar 100% sem IA (zero tokens).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Limite de tokens de resposta por chamada (controla custo)
AI_MAX_TOKENS=1000
# Exemplo Ollama local (grátis): AI_BASE_URL=http://localhost:11434/v1  AI_MODEL=llama3.1  AI_API_KEY=ollama

# ---------- Instagram e X/Twitter (opcional) ----------
# Essas redes bloqueiam scraping sem login. O projeto usa atores do Apify (https://apify.com).
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR=apify/instagram-hashtag-scraper
APIFY_TWITTER_ACTOR=apidojo/tweet-scraper

# ---------- YouTube ----------
# Idioma/região dos resultados e dos títulos
YT_LANG=pt
YT_REGION=BR
# Quantos vídeos recebem coleta detalhada (likes, comentários, data, legenda de abertura)
YT_ENRICH_TOP=25
# Quantos vídeos têm a legenda dos primeiros segundos baixada (gancho falado)
YT_TRANSCRIPT_TOP=8

# ---------- Geral ----------
# Caminho relativo à raiz do projeto (ou absoluto / com ~ se quiser fora do projeto)
DB_PATH=data/app.db
HOST=127.0.0.1
PORT=8000
# Fuso para "melhor dia/horário de publicação" (formato IANA)
APP_TIMEZONE=America/Sao_Paulo

# ---------- Ambiente (usado pelo Makefile) ----------
# Deixe vazio para o Makefile detectar sozinho o melhor Python >= 3.10 da máquina.
PYTHON=
# Pasta do ambiente virtual
VENV=.venv
